  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Guard plans, notes, and files across context compaction, with a model tool and per-Session permissions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamitobiHaru/dsh-plan-guard.git"
  },
  "homepage": "https://github.com/KamitobiHaru/dsh-plan-guard#readme",
